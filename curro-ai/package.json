{
  "name": "curro-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Curro AI — a fast, reliable, autonomous local coding agent (TypeScript + Express).",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/agents/tools/fileRead.test.ts src/agents/tools/readImage.test.ts src/agents/tools/applyMultipleEdits.test.ts src/agents/tools/shall.test.ts src/agents/tools/shellView.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "7.0.2"
  }
}
